<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <!-- Background bar -->
    <children>
        <Rectangle width="200" height="20" fill="gray" />
        <!-- Health fill: its width will be bound in the controller -->
        <Rectangle fx:id="healthBarFill" height="20" fill="green" />
    </children>
</StackPane>
