<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.StackPane?>
<AnchorPane fx:id="anchorPane" xmlns:fx="http://javafx.com/fxml" fx:controller="com.angrytanks.ui.controllers.ShopController" prefWidth="1980" prefHeight="1080">
    <!-- Header -->
    <ImageView fx:id="backgroundImage"
               fitWidth="1920"
               fitHeight="1080"
               preserveRatio="false" />

    <Label text="Tank Shop" layoutX="50" layoutY="20" styleClass="title-label"/>
    <!-- Back Button -->
    <Button text="Back" layoutX="50" layoutY="80" onAction="#onBack" styleClass="button"/>
    <!-- Scrollable list of tanks available for purchase -->
    <ScrollPane fx:id="scrollPane" style="-fx-background-color: #444444" styleClass="scroll-pane" layoutX="50" layoutY="140" prefWidth="1880" prefHeight="900">
        <content>
            <VBox fx:id="tankListVBox" style="-fx-background-color: #444444" spacing="20">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20" />
                </padding>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>
