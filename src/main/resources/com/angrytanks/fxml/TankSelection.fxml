<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.angrytanks.ui.controllers.TankSelectionController"
            prefWidth="800" prefHeight="600">
    <Label text="Enter Your Name:" layoutX="300" layoutY="200"/>
    <TextField fx:id="nameField" layoutX="420" layoutY="195" />
    <Button text="Select Tank  Start" layoutX="350" layoutY="250" onAction="#onTankSelected"/>
    <Button text="Back to Menu" layoutX="350" layoutY="300" onAction="#onBackClicked"/>
</AnchorPane>
