<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.angrytanks.ui.controllers.WinLoseController"
           prefWidth="1920" prefHeight="1080"
           fx:id="stackPane">
    <!-- Background image filling the screen -->
    <ImageView fx:id="backgroundImage"
               fitWidth="1920"
               fitHeight="1080"
               preserveRatio="false" />

    <!-- Centered vertical layout for title, message, and buttons -->
    <VBox alignment="CENTER" spacing="20">
        <!-- Title label (e.g., "You Win!" or "You Lose!") -->
        <Label fx:id="titleLabel" text="You Win!" styleClass="title-label" />

        <!-- Message label providing additional context -->
        <Label fx:id="messageLabel" text="Congratulations, you have defeated the enemy!" styleClass="label" wrapText="true" maxWidth="600"/>

        <!-- Buttons for further action -->
        <VBox alignment="CENTER" spacing="10">
            <Button text="Main Menu" onAction="#onMainMenu" styleClass="button" />
        </VBox>
    </VBox>

    <!-- Padding around the content -->
    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>
</StackPane>
